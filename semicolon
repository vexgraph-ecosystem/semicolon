#!/bin/sh
# Resolve this checkout without relying on the caller's cwd or on the shell
# following a symlink into another directory. Builds the binary on first use or
# when its source inputs have changed, then
# replaces this process with it. No shell configuration is edited, nothing is
# fetched, and no program other than the shell itself is run.
set -eu
launcher=$0
if [ "${launcher#*/}" = "$launcher" ]; then
    launcher=$(command -v "$launcher") || exit 1
fi
while [ -L "$launcher" ]; do
    target=$(readlink "$launcher") || exit 1
    case "$target" in
        /*) launcher=$target ;;
        *) launcher=$(dirname -- "$launcher")/$target ;;
    esac
done
root=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd) || exit 1
binary=$root/.build/semicolon-tui
determinant=${SEMICOLON_DETERMINANT_SOURCE_DIR:-$root/../../ecosystem/determinant/src}
vexspoke=${SEMICOLON_VEXSPOKE_SOURCE_DIR:-$root/../../ecosystem/vexspoke/src}
engine=${SEMICOLON_ENGINE_SOURCE_DIR:-$root/../../ecosystem/relational-engine/src}
language=${SEMICOLON_LANGUAGE_SOURCE_DIR:-$root/../../ecosystem/language}
rebuild=false
if [ ! -x "$binary" ]; then
    rebuild=true
elif [ "$root/build.py" -nt "$binary" ] || [ "$root/semicolon" -nt "$binary" ]; then
    rebuild=true
elif find "$root/src" "$determinant" "$vexspoke" "$engine" "$language" -type f \
        \( -name '*.c' -o -name '*.h' \) -newer "$binary" -print -quit | grep -q .; then
    rebuild=true
fi
if [ "$rebuild" = true ]; then
    printf '%s\n' 'semicolon: source changed, rebuilding the terminal shell...' >&2
    python3 "$root/build.py" >&2 || exit 1
fi
exec "$binary" "$@"
